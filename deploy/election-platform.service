[Unit]
Description=UP Election Intelligence & War Room Platform
After=network.target

[Service]
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/eci
Environment="PATH=/home/ubuntu/eci/venv/bin:/usr/local/bin:/usr/bin:/bin"
ExecStart=/home/ubuntu/eci/venv/bin/python run_platform.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
