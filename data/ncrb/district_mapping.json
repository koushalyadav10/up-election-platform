{
  "_metadata": {
    "description": "Historical mapping and boundary evolution for Uttar Pradesh districts in NCRB Crime in India reports (2000-2024)",
    "rule_reference": "Section 43 - District Mapping & Boundary Metadata",
    "disclaimer": "District boundaries and police reporting units changed during 2000-2024. Direct comparison across boundary splits must account for parent territory changes."
  },
  "historical_events": [
    {
      "year": 2000,
      "event": "State Reorganization",
      "detail": "13 hill districts separated to form Uttarakhand. UP remained with 70 districts."
    },
    {
      "year": 2008,
      "event": "Creation of Kanshiram Nagar",
      "detail": "Carved out of Etah district; later renamed Kasganj in 2012."
    },
    {
      "year": 2010,
      "event": "Creation of CSM Nagar",
      "detail": "Carved out of Sultanpur and Rae Bareli; later renamed Amethi in 2012."
    },
    {
      "year": 2011,
      "event": "Creation of 3 New Districts",
      "detail": "Bhim Nagar (renamed Sambhal), Panchsheel Nagar (renamed Hapur), and Prabuddha Nagar (renamed Shamli)."
    },
    {
      "year": 2018,
      "event": "District Renaming",
      "detail": "Faizabad renamed to Ayodhya, and Allahabad renamed to Prayagraj."
    },
    {
      "year": 2020,
      "event": "Police Commissionerate System",
      "detail": "Lucknow and Gautam Buddha Nagar transitioned to Commissionerate policing; expanded later to Kanpur, Varanasi, Agra, Ghaziabad, and Prayagraj."
    }
  ],
